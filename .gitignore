# Only what is listed here is published. Everything else in this folder (research material,
# Sony's app packages, clips, logs, private notes) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/requirements.txt
!/PRIVACY.md
!/docs/
!/.github/
!/TetherStudio/
!/esp32_bridge/
!/zve10/
!/tests/
!/probe/

# Never publish
esp32_bridge/camera_wifi.txt
bridge.json
mcp-token

# Build output
.build/
build/
dist/
.swiftpm/
esp32_bridge/idf/build/
esp32_bridge/idf/sdkconfig
esp32_bridge/idf/sdkconfig.old
esp32_bridge/idf/managed_components/
__pycache__/
*.pyc
.DS_Store

# Libraries built for the app (scripts/build_deps.sh)
.deps/
